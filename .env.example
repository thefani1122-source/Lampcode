# ─────────────────────────────────────────────────────────────────────────────
# Lampcode Backend — Environment Variables
#
# SETUP:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in the values below
#   3. Run locally:      npm run dev   (loads .env automatically)
#   4. Production:        paste the SAME keys into Railway → your service → Variables
#                         (Railway injects them; no .env file needed in prod)
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# ── REQUIRED (server refuses most endpoints without these) ───────────────────

# Postgres connection string.
# Supabase → Project Settings → Database → Connection string → "URI" (use the
# pooler/Transaction string for serverless, or the direct string for Railway).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Supabase project URL + SERVICE ROLE key (NOT the anon key — service role).
# Supabase → Project Settings → API.
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...your_service_role_key...

# OpenRouter API key (this is what calls Claude/DeepSeek/etc).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Redis URL. Local: redis://localhost:6379
# Hosted: Upstash (https://upstash.com) or Railway Redis plugin → copy the URL.
REDIS_URL=redis://localhost:6379

# Encryption key for stored secrets/env vars. MUST be exactly 64 hex chars.
# Generate one:   openssl rand -hex 32
ENCRYPTION_KEY=

# ── E2B sandbox (REQUIRED for live fullstack preview) ────────────────────────

# E2B API key — https://e2b.dev/dashboard → Keys.
E2B_API_KEY=e2b_...

# The custom template you build once with the E2B CLI (steps below in chat /
# README). "lampcode-vite" is the alias; you can also use the template ID the
# CLI prints after building.
E2B_TEMPLATE_ID=lampcode-vite

# ── Internal platform MCP tools (optional — enables web scraping & search) ───

# Firecrawl — scrape/crawl URLs, extract structured content.
# Get a key at https://firecrawl.dev → Dashboard → API Keys
FIRECRAWL_API_KEY=

# Exa — semantic web search optimised for AI agents.
# Get a key at https://exa.ai → Dashboard → API Keys
EXA_API_KEY=

# ── CORS / frontend origin ───────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND_URL=https://vibe-coder-suite.vercel.app

# ── OPTIONAL — Stripe billing (works in dev-stub mode if left blank) ─────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# KIMI_API_KEY=
# REDIS_PUBLIC_URL=
