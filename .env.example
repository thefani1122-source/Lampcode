# ─────────────────────────────────────────────────────────────────────────────
# Lampcode Backend — Environment Variables
#
# SETUP:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in the values below
#   3. Run locally:      npm run dev   (loads .env automatically)
#   4. Production:       paste the same keys into Railway → service → Variables
#
# The authoritative list is src/server/config.ts. This file is checked against
# it; if you add a var there, add it here. It had drifted badly once — it
# advertised OPENROUTER_API_KEY as "what calls Claude", which is not read
# anywhere in the codebase, and Stripe, which Paddle replaced.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Postgres connection string.
# Supabase → Project Settings → Database → Connection string → "URI".
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Supabase project URL + SERVICE ROLE key (NOT the anon key).
# Supabase → Project Settings → API.
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...your_service_role_key...

# Redis. Local: redis://localhost:6379
# NOTE: in production this points at the Redis service in a DIFFERENT Railway
# project, so it goes over the public TCP proxy, not private networking.
# A dead Redis is silent — rate limiting fails open and sandbox IDs stop
# persisting — so check the service's latest deployment before trusting it.
REDIS_URL=redis://localhost:6379
# REDIS_PUBLIC_URL=

# Encryption key for stored secrets. MUST be exactly 64 hex chars.
# Generate one:   openssl rand -hex 32
ENCRYPTION_KEY=

# ── LLM PROVIDER ─────────────────────────────────────────────────────────────
# The gateway speaks any OpenAI-compatible /v1/chat/completions endpoint and
# APPENDS that path itself, so the URL must NOT already end in /v1.
#
# Currently Amazon Bedrock. The path differs between its two surfaces:
#   bedrock-mantle  serves /v1/chat/completions      → URL ends at the host
#   bedrock-runtime serves /openai/v1/chat/...       → URL ends at /openai
# Getting this wrong returns AWS's Coral envelope with HTTP 200, which the SSE
# parser reads as an empty reply — it looks exactly like a model that cannot
# call tools. The tell is `totalChunks=2` in the [stream] log line.
#
# The two endpoints also hold SEPARATE per-model token quotas, so a quota of 0
# on one says nothing about the other.
LLM_ENDPOINT_URL=https://bedrock-mantle.ap-southeast-2.api.aws
LLM_API_KEY=
LLM_MODEL_NAME=minimax.minimax-m2.5

# Caps the model's output. A PER-MODEL limit, not a preference: MiniMax M2.5
# tops out at 8000, Kimi K2.5 at 16000. Too high is rejected by the provider.
LLM_MAX_OUTPUT_TOKENS=8000

# Forces every build to the OpenAI-compatible endpoint. Without this the
# provider is chosen PER PLAN, so a paid or admin account silently gets
# Anthropic no matter what the LLM_* vars say.
LLM_PROVIDER_MODE=openai

# Non-standard field, kept for GLM-5.3 which forces reasoning on and spent its
# whole budget thinking at the default effort. Set it to `off` for any model
# that does not accept it — which includes every Bedrock model.
MODAL_REASONING_EFFORT=off

# Legacy fallbacks for the three LLM_* names above (LLM_* wins). Leave these
# EMPTY: a stale URL here is what a missing LLM_* var falls back to, so it
# turns a loud failure into a silent one against a dead endpoint.
# MODAL_ENDPOINT_URL=
# MODAL_PROXY_TOKEN=
# MODAL_MODEL_NAME=

# Only used when a build routes to Anthropic directly. Not set in production.
# ANTHROPIC_API_KEY=

# Add a MODEL_PRICING row in src/agents/token-tracker.ts for any model you set
# above. It is an EXACT lookup on LLM_MODEL_NAME; a miss falls back to
# $1.00/$4.00 with only a warning, which misprices every build and takes the
# cost guard and the user's deducted credits down with it. Rates are
# region-specific.

# ── E2B sandbox (REQUIRED for live preview) ──────────────────────────────────

# https://e2b.dev/dashboard → Keys
E2B_API_KEY=e2b_...

# Built from e2b-template/template.ts via `npx tsx build.ts` — NOT from either
# of the two orphan Dockerfiles. After every build run
# `npx tsx verify-template.ts`: a failed template build leaves the LAST GOOD
# image serving silently, which is how check_page stayed broken for 3 weeks.
E2B_TEMPLATE_ID=lampcode-vite

# Do NOT set this. The Next.js template has never been built, so this points at
# no real image and a sandbox using it cannot boot.
# NEXTJS_TEMPLATE_ID=

# ── Build harness ────────────────────────────────────────────────────────────
# All three booleans use explicit-string parsing, because z.coerce.boolean()
# reads the string "false" as true.

# The agentic harness. TRUE by default; this is the kill switch back to fence
# parsing.
# AGENTIC_BUILD_ENABLED=true
# Default 12. Railway runs 40, raised for a long test — revisit before launch.
# AGENTIC_MAX_TURNS=12

# A cheap file-by-file plan before long new builds.
# BUILD_PLANNING_ENABLED=true
# BUILD_PLAN_MIN_WORDS=38

# The two dispatches that compare the user's words to the delivered files.
# COMPLETION_AUDIT_ENABLED=true

# Hard ceiling on one build's model spend, in USD.
# Raised to 3.0 on Railway for a long-running test — revisit before launch.
# MAX_BUILD_COST_USD=3.0

# What recorded usage is multiplied by before it is stored as usage_usd.
# USAGE_MARGIN_MULTIPLIER=4

# ── Access control ───────────────────────────────────────────────────────────

# Pre-launch gate, TRUE by default. Blocks /api/build/fast for non-admins and
# /paddle/config for EVERYONE, admins included. The frontend needs
# VITE_WAITLIST_MODE set to match.
WAITLIST_MODE=true

# Comma-separated. Bypasses the waitlist. Mirror these into the frontend's
# VITE_ADMIN_EMAILS or an admin is gated by the UI even though the API lets
# them through.
ADMIN_EMAILS=

# ── CORS / frontend origin ───────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND_URL=https://vibe-coder-suite.vercel.app

# ── Preview database handed to GENERATED apps ────────────────────────────────
# A separate project from the one above — these are injected into the sandbox,
# so they must never be Lampcode's own credentials.
# PREVIEW_SUPABASE_URL=
# PREVIEW_SUPABASE_ANON_KEY=
# PREVIEW_SUPABASE_SERVICE_KEY=
# PREVIEW_MONGODB_URI=

# ── Internal platform MCP tools (optional) ───────────────────────────────────
# Attached to every build, so they are deliberately NOT sent on the
# OpenAI-compatible path: each costs a discovery round trip plus its full tool
# list in every round's context.
FIRECRAWL_API_KEY=
EXA_API_KEY=

# ── Billing — Paddle (Stripe is dead; its vars are vestigial) ────────────────
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRICE_PRO_MONTHLY=
# PADDLE_PRICE_PRO_YEARLY=
# PADDLE_PRICE_POWER_MONTHLY=
# PADDLE_PRICE_POWER_YEARLY=
# PADDLE_PRICE_MAX_MONTHLY=
# PADDLE_PRICE_MAX_YEARLY=
# PADDLE_PRICE_TOPUP_5=
# PADDLE_PRICE_TOPUP_15=
# PADDLE_PRICE_TOPUP_30=
# PADDLE_PRICE_TOPUP_75=

# Still in the config schema, read by nothing that matters. Do not wire these
# back up without deciding which processor the product actually uses.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ENTERPRISE=

# ── Eval harness (scripts/eval) — spends REAL money, every task is a build ───
# It signs itself in and refreshes the token, because a run outlasts the ~1h
# Supabase token life. The account must be an admin while WAITLIST_MODE is on.
# EVAL_BASE_URL=https://lampcode-production.up.railway.app
# EVAL_EMAIL=
# EVAL_PASSWORD=
# EVAL_SUPABASE_ANON_KEY=
# EVAL_TOKEN= (override; never refreshed, so it expires mid-run)
