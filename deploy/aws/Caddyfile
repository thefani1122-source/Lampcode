# Filled in by bootstrap.sh. Caddy gets and renews the certificate itself;
# there is nothing to run on a schedule and nothing that expires silently.
@HOST@ {
	encode zstd gzip

	# Socket.IO needs the connection upgraded and must NOT be buffered or
	# time-limited the way a normal request is — a build streams for minutes
	# over one connection. Caddy proxies websockets natively; the long
	# timeouts below are what stop a working build being cut off at 30s.
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
		transport http {
			read_timeout 1h
			write_timeout 1h
			dial_timeout 10s
		}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
